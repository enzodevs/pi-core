{
	"name": "@rrghost/pi-core",
	"version": "0.1.0",
	"description": "Lean interactive tools, skill visibility, session utilities, and Fast mode for the Pi coding agent",
	"license": "MIT",
	"author": "Enzo Cambraia",
	"homepage": "https://github.com/enzodevs/pi-core#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/enzodevs/pi-core.git"
	},
	"bugs": {
		"url": "https://github.com/enzodevs/pi-core/issues"
	},
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"files": [
		"extensions",
		"skills",
		"CONTEXT-HYGIENE.md",
		"LICENSE",
		"README.md"
	],
	"pi": {
		"skills": [
			"./skills/analyze-sessions"
		],
		"extensions": [
			"./extensions/skill-manager/index.ts",
			"./extensions/fast-mode/index.ts",
			"./extensions/file-autocomplete/index.ts",
			"./extensions/footer/index.ts",
			"./extensions/ui/index.ts",
			"./extensions/session-cwd/index.ts",
			"./extensions/nested-agents/index.ts",
			"./extensions/recap/index.ts",
			"./extensions/session-title/index.ts",
			"./extensions/draft-toggle/index.ts",
			"./extensions/image-clipboard/index.ts",
			"./extensions/background-process/index.ts",
			"./extensions/memory/index.ts",
			"./extensions/json-headroom/index.ts",
			"./extensions/sudo/index.ts",
			"./extensions/ask-user-question/index.ts",
			"./extensions/subagent/index.ts",
			"./extensions/context-inspector/index.ts",
			"./extensions/whatsapp/index.ts"
		]
	},
	"scripts": {
		"check": "npm run review:skill:check && npm run format:check && npm run typecheck && npm test && npm run fallow",
		"review:skill:check": "node scripts/sync-review-skill.mjs --check",
		"compat:latest": "node scripts/compat-latest.mjs",
		"compat:package": "node scripts/package-smoke.mjs",
		"benchmark:fast": "node extensions/fast-mode/benchmark.mjs",
		"headroom:install": "node extensions/json-headroom/setup.mjs",
		"headroom:test": "node extensions/json-headroom/check.mjs",
		"fallow": "fallow dead-code --no-cache --fail-on-issues --format compact --quiet",
		"fallow:health": "fallow health --no-cache --report-only --format compact --quiet",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "^1.0.0",
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@earendil-works/pi-tui": "^1.0.0",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@earendil-works/pi-agent-core": "1.0.0",
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@types/node": "^24.0.0",
		"@types/proper-lockfile": "^4.1.4",
		"@types/qrcode": "1.5.6",
		"fallow": "3.17.0",
		"typebox": "^1.0.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22",
			"onFail": "error"
		}
	},
	"dependencies": {
		"@whiskeysockets/baileys": "6.7.24",
		"pino": "9.14.0",
		"proper-lockfile": "4.1.2",
		"qrcode": "1.5.4"
	}
}
